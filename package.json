{
  "name": "uniform-combinations",
  "private": true,
  "description": "Interactive 3D football uniform combo builder",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.js",
    "prepare:player": "node tools/prepare-player.mjs",
    "prepare:helmet": "node tools/prepare-helmet.mjs",
    "prepare:uniforms": "python3 tools/prepare-uniforms.py"
  },
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.2.0",
    "@gltf-transform/extensions": "^4.2.0",
    "@gltf-transform/functions": "^4.2.0",
    "fbx2gltf": "^0.9.7-p1",
    "obj2gltf": "^3.1.6"
  }
}
